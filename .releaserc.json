{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "minor" },
          { "type": "feat", "release": "patch" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "docs", "scope": "readme", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features" },
            { "type": "feature", "section": "Features" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "perf", "section": "Performance Improvements" },
            { "type": "revert", "section": "Reverts" },
            { "type": "docs", "scope": "readme", "section": "Documentation" },
            { "type": "docs", "section": "Documentation", "hidden": true },
            { "type": "style", "section": "Styles", "hidden": true },
            { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
            { "type": "refactor", "section": "Code Refactoring", "hidden": true },
            { "type": "test", "section": "Tests", "hidden": true },
            { "type": "build", "section": "Build System", "hidden": true },
            { "type": "ci", "section": "Continuous Integration", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/sr-stamp.mjs ${nextRelease.version} && pnpm build",
        "publishCmd": "MAIN_REF=HEAD bash scripts/release-publish.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to `@agenttrail/guardrails` are recorded here, newest first. Sections from\n`0.2.1` on are generated by semantic-release from the Conventional Commits on `main`;\nearlier sections were written by hand in the\n[Keep a Changelog](https://keepachangelog.com/en/1.0.0/) style.\n\nThe project follows [Semantic Versioning](https://semver.org/spec/v2.0.0.html). While the\nversion is below `1.0.0`, a **breaking change bumps the minor** and anything else the patch.\nFor this package, breaking means a removed guardrail, a renamed guardrail id, or a default\naction made stricter; adding a guardrail or a pack is a feature."
      }
    ],
    ["@semantic-release/npm", { "npmPublish": false }],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "src/stamp.ts", "CHANGELOG.md"],
        "message": "Release ${nextRelease.version}\n\n${nextRelease.notes}\n\nCo-Authored-By: Claude <noreply@anthropic.com>"
      }
    ],
    "@semantic-release/github"
  ]
}
